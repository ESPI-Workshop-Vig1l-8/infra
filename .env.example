# docker env file — copy to .env and fill in
# Passwords must not contain double quotes or backslashes.

# CouchDB admin (used by the init job and for administration only)
COUCHDB_USER=admin
COUCHDB_PASSWORD=

# CouchDB service accounts, created by the history-db-init job:
# user "backend" (read/write) and user "ia" (read-only)
COUCHDB_BACKEND_PASSWORD=
COUCHDB_IA_PASSWORD=

# Address the MQTTS port (18883) listens on: the hotspot address. 127.0.0.1 to test without the hotspot.
MQTT_BIND_IP=192.168.10.1

# Mosquitto accounts, written to config/mosquitto/passwd by scripts/mqtt-passwd.sh:
# user "backend" (the AI services read CouchDB, they have no broker account)
MQTT_BACKEND_PASSWORD=

# Sensor nodes: comma-separated <device_id>:<password> (device_id = MQTT username)
MQTT_DEVICE_ACCOUNTS=VIG1L-8-NODE04:

# Backend API tokens (16+ chars, different), e.g. `openssl rand -hex 24`:
# operator = dashboard access key (everything, including commands)
# service  = AI services (read + POST /api/v1/alerts)
API_OPERATOR_TOKEN=
API_SERVICE_TOKEN=

# IA_Vision container (Linux only): webcam device, gid of the host's "video"
# group (`getent group video`), node whose LED blinks on a confirmed intrusion
#VISION_CAMERA=/dev/video0
#VIDEO_GID=44
#VISION_DEVICE_ID=VIG1L-8-NODE04
# Windows/macOS: IA_Vision runs on the host instead; point the dashboard to it
# with an IP reachable from the containers, e.g. the hotspot address:
#VISION_UPSTREAM=http://192.168.10.1:8000
